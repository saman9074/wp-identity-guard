{
  "name": "arcaneteam/wp-identity-guard",
  "description": "WP Identity Guard (Free): privacy-conscious identity and bank-card ownership verification embedded in existing WordPress account screens. Not a payment gateway.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "plugin",
    "identity-verification",
    "kyc",
    "shahkar",
    "woocommerce"
  ],
  "homepage": "https://github.com/saman9074/wp-identity-guard",
  "support": {
    "issues": "https://github.com/saman9074/wp-identity-guard/issues",
    "source": "https://github.com/saman9074/wp-identity-guard",
    "security": "https://github.com/saman9074/wp-identity-guard/security/policy"
  },
  "authors": [
    {
      "name": "ArcaneTeam",
      "homepage": "https://github.com/saman9074"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^3.0 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "WPIG\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WPIG\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "wpig": {
      "version": "0.1.0-alpha.1",
      "status": "v0.1.0-alpha.1 public preview (P01 Foundation complete; P02-P05 not yet implemented)",
      "support-floor": "PHP >= 8.3, WordPress >= 6.9, WooCommerce >= 10.8 (optional) - confirmed D02"
    }
  },
  "scripts": {
    "lint": "find wp-identity-guard.php uninstall.php src tests tools -name '*.php' -print0 | xargs -0 -n1 -P4 php -l",
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "stan": "phpstan analyse --memory-limit=1G",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "WPIG_INTEGRATION_BOOTSTRAP=1 phpunit --testsuite integration",
    "scan:sensitive": "@php tools/sensitive-scan.php",
    "build:zip": "@php tools/build-release-zip.php",
    "check:offline": [
      "@lint",
      "@scan:sensitive"
    ],
    "check": [
      "@check:offline",
      "@cs",
      "@stan",
      "@test:unit"
    ]
  },
  "scripts-descriptions": {
    "lint": "PHP syntax check (no dependencies).",
    "scan:sensitive": "Heuristic secret/PII scan of tracked files.",
    "build:zip": "Build and verify a clean WordPress-installable plugin ZIP.",
    "check:offline": "All checks that run without composer install.",
    "check": "Full local gate (requires composer install of require-dev)."
  }
}
